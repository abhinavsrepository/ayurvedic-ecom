# Docker-based Configuration (Original)
# 
# Use this if you want to run PostgreSQL and Redis in Docker:
#   docker-compose up -d
#
# Then copy this file to .env:
#   copy .env.docker .env

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ayurveda_admin

# JWT Secrets (change these in production!)
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-characters-long
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-min-32-chars

# Server
PORT=3333
NODE_ENV=development

# CORS (frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=3600

# Payment Gateways (optional - add your keys)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
